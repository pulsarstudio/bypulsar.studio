---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WorkMedia from "../../components/WorkMedia.astro";
import { brand } from "../../config";
import { en } from "../../i18n/dict";
import { readProject, readProjects } from "../../lib/cadence/client";
import { aboutInEnglish, aboutOf, galleryAlt, tagKey, variant } from "../../lib/work";

const slug = Astro.params.slug ?? "";
// Cadence shows a project's id as `project-<slug>`: an address copied from there still lands.
if (slug.startsWith("project-")) return Astro.redirect(`/work/${slug.slice("project-".length)}`, 301);

const [read, list] = await Promise.all([readProject(slug), readProjects()]);
if (read.state === "missing") return Astro.rewrite("/404");
if (read.state === "unavailable") return Astro.redirect("/work", 302);

const project = read.data;
const others = list.state === "ok" ? list.data : [];
const index = others.findIndex((other) => other.slug === project.slug);
const next = others.length > 1 ? others[(index + 1) % others.length] : null;
---

<Layout title={`${project.name} — ${brand.name}`} description={aboutInEnglish(project)} intro={false}>
  <Header />
  <main>
    <section class="ds-section">
      <div class="ds-section-inner">
        <a href="/work" class="ds-link-external mb-10 md:mb-14">
          <span aria-hidden="true">←</span>
          <span data-i18n="work.ui.back">{en["work.ui.back"]}</span>
        </a>

        <h1 class="ds-heading-section mb-10 lowercase md:mb-14">{project.name}</h1>

        {project.cover && <WorkMedia src={project.cover.w1600} alt={project.cover.alt ?? project.name} eager />}

        <dl class="project-sheet">
          <div class="project-sheet-block">
            <div>
              <dt class="ds-label" data-i18n="work.ui.project">{en["work.ui.project"]}</dt>
              <dd class="ds-meta-value">{project.name}</dd>
            </div>
            <div>
              <dt class="ds-label" data-i18n="work.ui.client">{en["work.ui.client"]}</dt>
              <dd class="ds-meta-value">{project.client}</dd>
            </div>
          </div>

          <div class="project-sheet-block">
            {project.tags.length > 0 && (
              <div>
                <dt class="ds-label" data-i18n="work.ui.tags">{en["work.ui.tags"]}</dt>
                <dd class="mt-3 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <a href={`/work?tag=${tagKey(tag)}`} class="ds-pill-outline">{tag}</a>
                  ))}
                </dd>
              </div>
            )}
            <div>
              <dt class="ds-label" data-i18n="work.ui.year">{en["work.ui.year"]}</dt>
              <dd class="ds-meta-value">{project.year}</dd>
            </div>
          </div>

          <div class="project-sheet-block">
            <div>
              <dt class="ds-label" data-i18n="work.ui.about">{en["work.ui.about"]}</dt>
              <dd class="ds-meta-value" data-localized={JSON.stringify(aboutOf(project))}>{aboutInEnglish(project)}</dd>
            </div>
            {project.url && (
              <div>
                <a href={project.url} target="_blank" rel="noopener" class="ds-btn-primary-dark">
                  <span data-i18n="work.ui.visit">{en["work.ui.visit"]}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )}
          </div>
        </dl>

        {project.gallery.length > 0 && (
          <ul class="project-gallery">
            {project.gallery.map((entry) => (
              <li>
                {entry.kind === "video" ? (
                  <WorkMedia
                    src={variant(entry.url, 1600)}
                    alt={galleryAlt(entry, project.name)}
                    video={{ src: entry.videoUrl, type: entry.videoType }}
                  />
                ) : (
                  <WorkMedia src={variant(entry.url, 1600)} alt={galleryAlt(entry, project.name)} />
                )}
              </li>
            ))}
          </ul>
        )}

        {project.copyright && (
          <div class="mt-16 max-w-3xl md:mt-24">
            <p class="ds-label" data-i18n="work.ui.copyright">{en["work.ui.copyright"]}</p>
            <p class="project-copyright">{project.copyright}</p>
          </div>
        )}
      </div>
    </section>

    {next && next.slug !== project.slug && (
      <section class="ds-section">
        <a href={`/work/${next.slug}`} class="project-next ds-section-inner">
          <p class="ds-label" data-i18n="work.ui.next">{en["work.ui.next"]}</p>
          <p class="project-next-name">
            <span>{next.name.toLowerCase()}</span>
            <span class="project-next-arrow" aria-hidden="true">→</span>
          </p>
        </a>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script is:inline>
  // A project's paragraph comes from Cadence per language, not from the
  // dictionary: swap it when the site's language changes, falling back to English.
  document.addEventListener("pulsar:locale-changed", (event) => {
    document.querySelectorAll("[data-localized]").forEach((el) => {
      try {
        const texts = JSON.parse(el.getAttribute("data-localized") || "{}");
        el.textContent = texts[event.detail.locale] || texts.en || "";
      } catch (_) {}
    });
  });
</script>

<style>
  /* Three blocks: who, what kind, and the paragraph. */
  .project-sheet {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 3rem;
    margin: clamp(3rem, 6vw, 5rem) 0;
  }

  @media (min-width: 768px) {
    .project-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-sheet-block:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .project-sheet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }

    .project-sheet-block:last-child {
      grid-column: auto;
    }
  }

  .project-sheet-block {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-sheet dd {
    margin-left: 0;
  }

  .project-copyright {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    @apply text-muted;
  }

  /* Each photo keeps its own shape: two columns that fill top to bottom. */
  .project-gallery {
    list-style: none;
    padding: 0;
    margin: 0;
    column-gap: clamp(1rem, 2vw, 1.5rem);
  }

  .project-gallery > li {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  @media (min-width: 768px) {
    .project-gallery {
      column-count: 2;
    }
  }

  .project-next {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-next-name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    margin: 1.5rem 0 0;
    @apply font-display font-bold text-fg;
    font-size: clamp(36px, 6vw, 88px);
    letter-spacing: -0.04em;
    line-height: 0.95;
    transition: opacity 0.3s ease;
  }

  .project-next-arrow {
    transition: transform 0.3s ease;
  }

  .project-next:hover .project-next-name,
  .project-next:focus-visible .project-next-name {
    opacity: 0.6;
  }

  .project-next:hover .project-next-arrow,
  .project-next:focus-visible .project-next-arrow {
    transform: translateX(6px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-next-name,
    .project-next-arrow {
      transition: none;
    }
  }
</style>
