---
import { cadence } from "../config";
import CadenceMark from "./CadenceMark.astro";

const features = [
  "Multi-tenant",
  "Events",
  "Gallery",
  "Store",
  "Cadence AI",
];
---

<section id="cadence" class="ds-section-card-wrap">
  <div class="ds-ink-card cadence-card">
    <div class="ds-ink-card-inner cadence-grid">
      <div class="cadence-text">
        <p class="cadence-eyebrow" data-i18n="cadence.eyebrow">our SaaS</p>

        <h2 class="cadence-title">cadence.</h2>

        <p class="cadence-lead" data-i18n="cadence.lead">
          Our SaaS for active communities. A professional site you run by chat —
          no CMS, no panels.
        </p>

        <ul class="cadence-features">
          {features.map((f, i) => (
            <li class="cadence-feature" data-i18n={`cadence.feature.${i}`}>{f}</li>
          ))}
        </ul>

        <div class="cadence-actions">
          <a href={cadence.page} class="cadence-cta">
            <span data-i18n="cadence.cta">How Cadence works</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href={cadence.legal} class="ds-link text-sm" data-i18n="cadence.privacy">
            Privacy policy
          </a>
        </div>
      </div>

      <CadenceMark />
    </div>
  </div>
</section>

<style>
  .cadence-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .cadence-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  /* ─── Text column ────────────────────────────────────── */
  .cadence-eyebrow {
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.05em;
    color: #9a9a9a;
    margin: 0 0 2rem 0;
    text-transform: uppercase;
  }

  .cadence-title {
    margin: 0 0 1.5rem 0;
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(56px, 9vw, 140px);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #f5f5f5;
  }

  .cadence-lead {
    margin: 0 0 2rem 0;
    max-width: 32rem;
    font-size: clamp(15px, 1.1vw, 17px);
    color: #9a9a9a;
    line-height: 1.55;
  }

  .cadence-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cadence-feature {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(245, 245, 245, 0.12);
    background: rgba(245, 245, 245, 0.04);
    color: #f5f5f5;
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: 13px;
    font-weight: 500;
  }

  .cadence-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .cadence-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #f5f5f5;
    color: #0a0a0a;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .cadence-cta:hover {
    transform: translateY(-1px);
    background: #ffffff;
  }
</style>
