---
import { projects } from "../config";
---

<section id="work" class="ds-section">
  <div class="ds-section-inner">
    <header class="work-header">
      <p class="ds-label" data-i18n="work.eyebrow">Selected work</p>
      <h2 class="ds-heading-section work-title">
        <span data-i18n="work.title">work.</span>
        <sup class="work-count">({projects.length})</sup>
      </h2>
    </header>

    <ol class="work-list">
      {projects.map((project) => {
        const Row = project.url ? "a" : "div";
        const linkProps = project.url
          ? { href: project.url, target: "_blank", rel: "noopener" }
          : {};
        return (
          <li>
            <Row class:list={["work-row", { "work-row-link": project.url }]} {...linkProps}>
              <span class="work-name">{project.name.toLowerCase()}</span>

              <div class="work-meta">
                <p class="ds-label" data-i18n={`work.${project.i18nKey}.client`}>
                  {project.client}
                </p>
                <ul class="work-cats">
                  {project.categories.map((c) => (
                    <li class="ds-pill">{c}</li>
                  ))}
                </ul>
                <p class="ds-body work-lead" data-i18n={`work.${project.i18nKey}.lead`}>
                  {project.lead}
                </p>
              </div>

              {project.url && <span class="work-arrow" aria-hidden="true">↗</span>}
            </Row>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .work-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .work-title {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0;
  }

  .work-count {
    font-size: 0.32em;
    font-weight: 400;
    line-height: 1.3;
    margin-top: 0.4em;
    @apply text-muted;
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-list > li {
    @apply border-t border-line;
  }

  .work-list > li:last-child {
    @apply border-b;
  }

  .work-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem 2rem;
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .work-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 3rem;
      align-items: start;
    }
  }

  .work-name {
    @apply font-display font-bold lowercase text-fg;
    font-size: clamp(44px, 7vw, 104px);
    letter-spacing: -0.04em;
    line-height: 0.9;
    transition: opacity 0.3s ease;
  }

  .work-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .work-meta {
      grid-column: auto;
      padding-top: 0.75rem;
    }
  }

  .work-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-lead {
    margin: 0;
    max-width: 38rem;
  }

  .work-arrow {
    grid-column: 2;
    grid-row: 1;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1;
    transition: transform 0.3s ease;
    @apply text-fg;
  }

  @media (min-width: 1024px) {
    .work-arrow {
      grid-column: 3;
    }
  }

  .work-row-link:hover .work-name,
  .work-row-link:focus-visible .work-name {
    opacity: 0.6;
  }

  .work-row-link:hover .work-arrow,
  .work-row-link:focus-visible .work-arrow {
    transform: translate(4px, -4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-name,
    .work-arrow {
      transition: none;
    }
  }
</style>
