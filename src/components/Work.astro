---
import { en } from "../i18n/dict";
import { readProjects } from "../lib/cadence/client";
import { aboutInEnglish, aboutOf, homeProjects } from "../lib/work";

const read = await readProjects();
const projects = read.state === "ok" ? read.data : [];
const shown = homeProjects(projects);
---

<section id="work" class="ds-section">
  <div class="ds-section-inner">
    <header class="work-header">
      <p class="ds-label" data-i18n="work.eyebrow">Selected work</p>
      <h2 class="ds-heading-section work-title">
        <span data-i18n="work.title">work.</span>
        {projects.length > 0 && <sup class="work-count">({projects.length})</sup>}
      </h2>
    </header>

    {shown.length === 0 && (
      <p class="ds-body" data-i18n={read.state === "unavailable" ? "work.ui.unavailable" : "work.ui.empty"}>
        {read.state === "unavailable" ? en["work.ui.unavailable"] : en["work.ui.empty"]}
      </p>
    )}

    {shown.length > 0 && (
      <ol class="work-list">
        {shown.map((project) => (
          <li>
            <a href={`/work/${project.slug}`} class="work-row work-row-link">
              <span class:list={["work-name", { "work-name-long": project.name.length > 14 }]}>{project.name.toLowerCase()}</span>

              <div class="work-meta">
                <p class="ds-label">{project.client} · {project.year}</p>
                {project.tags.length > 0 && (
                  <ul class="work-cats">
                    {project.tags.map((tag) => (
                      <li class="ds-pill">{tag}</li>
                    ))}
                  </ul>
                )}
                <p class="ds-body work-lead" data-localized={JSON.stringify(aboutOf(project))}>
                  {aboutInEnglish(project)}
                </p>
              </div>

              <span class="work-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    )}

    {projects.length > 0 && (
      <a href="/work" class="ds-btn-primary-dark mt-12 md:mt-16">
        <span data-i18n="work.ui.all">{en["work.ui.all"]}</span>
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
</section>

<script is:inline>
  document.addEventListener("pulsar:locale-changed", (event) => {
    document.querySelectorAll("#work [data-localized]").forEach((el) => {
      try {
        const texts = JSON.parse(el.getAttribute("data-localized") || "{}");
        el.textContent = texts[event.detail.locale] || texts.en || "";
      } catch (_) {}
    });
  });
</script>

<style>
  .work-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .work-title {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.25rem;
    margin: 0;
  }

  .work-count {
    font-size: 0.32em;
    font-weight: 400;
    line-height: 1.3;
    margin-top: 0.4em;
    @apply text-muted;
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-list > li {
    @apply border-t border-line;
  }

  .work-list > li:last-child {
    @apply border-b;
  }

  .work-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem 2rem;
    padding: clamp(2rem, 4vw, 3.5rem) 0;
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .work-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 3rem;
      align-items: start;
    }
  }

  .work-name {
    @apply font-display font-bold lowercase text-fg;
    font-size: clamp(44px, 7vw, 104px);
    letter-spacing: -0.04em;
    line-height: 0.9;
    transition: opacity 0.3s ease;
  }

  .work-name-long {
    font-size: clamp(34px, 4.6vw, 68px);
    line-height: 0.95;
  }

  .work-meta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .work-meta {
      grid-column: auto;
      padding-top: 0.75rem;
    }
  }

  .work-cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .work-lead {
    margin: 0;
    max-width: 38rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-arrow {
    grid-column: 2;
    grid-row: 1;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1;
    transition: transform 0.3s ease;
    @apply text-fg;
  }

  @media (min-width: 1024px) {
    .work-arrow {
      grid-column: 3;
    }
  }

  .work-row-link:hover .work-name,
  .work-row-link:focus-visible .work-name {
    opacity: 0.6;
  }

  .work-row-link:hover .work-arrow,
  .work-row-link:focus-visible .work-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-name,
    .work-arrow {
      transition: none;
    }
  }
</style>
