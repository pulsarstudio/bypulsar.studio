---
interface Props {
  /** Image URL; null draws the empty frame (a project with no cover yet). */
  src: string | null;
  alt: string;
  /** width / height of the frame; omit to follow the image's own shape. */
  ratio?: number;
  eager?: boolean;
  /** A gallery video: the image is its poster. */
  video?: { src: string; type: string };
}

const { src, alt, ratio, eager = false, video } = Astro.props;
const style = ratio ? `aspect-ratio: ${ratio};` : undefined;
---

<div class:list={["ds-media", { "ds-media-framed": ratio }]} style={style}>
  {video ? (
    <video controls playsinline preload="none" poster={src ?? undefined} aria-label={alt}>
      <source src={video.src} type={video.type} />
    </video>
  ) : src ? (
    <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
  ) : (
    <span class="ds-media-placeholder" role="img" aria-label={alt}></span>
  )}
</div>
